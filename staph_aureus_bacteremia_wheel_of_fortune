  draw();
  ctl.isComplete = () => true;
  ctl.isCorrect = () => ctl.arr.every((v, i) => v === i);
  ctl.disable = () => { ctl.disabled = true; draw(); };
  ctl.markFeedback = () => { ctl.marked = true; draw(); };
}

