  const answering = q.attempt === 0 ? q.team : 1 - q.team;
  if (MCQ_TYPES.includes(q.item.type) && q.ctl.pickedOriginal() !== null) q.picks.push(q.ctl.pickedOriginal());
  logAttempt(q.item, answering, correct, q.attempt === 1);
  if (correct || q.attempt === 1) return finishQuestion(correct);

  // First attempt wrong: keep the answer hidden and offer the other team a steal.
  Sound.wrong();
