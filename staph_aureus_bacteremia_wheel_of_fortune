  let left = secs;
  const ring = $("#timer"), bar = ring.querySelector(".bar"), num = ring.querySelector("span");
  const paint = () => { num.textContent = String(left); bar.setAttribute("stroke-dashoffset", String(106.8 * (1 - left / secs))); ring.classList.toggle("low", left <= 10); };
  paint();
  state.timerId = setInterval(() => {
    left--; paint();
    if (left === 10) announce("10 seconds left");
    if (left > 0 && left <= 5) Sound.tick();
    if (left <= 0) { stopTimer(); announce("Time is up"); lockIn(true); }
  }, 1000);
}
function stopTimer() { if (state.timerId) { clearInterval(state.timerId); state.timerId = null; } }

/* Records one attempt (used for end-screen stats). */
function logAttempt(item, team, correct, steal) { state.log.push({ id: item.id, team, correct, steal, domain: item.domain, bloom: item.bloom }); }

function lockIn(timedOut) {
