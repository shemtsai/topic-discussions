/* =====================================================================
   WHEEL. Drawn once. A positive SVG rotation turns it clockwise. The
   wedge under the top pointer is the one whose original angle a
   satisfies (a + rotation) ≡ 0 (mod 360).
   ===================================================================== */
const SEG = 360 / WEDGES.length;
function puzzleOk(p) { return !!p && /^[A-Z ]+$/.test(p.phrase || "") && !!p.pearl && !!p.source && !!p.category; }
const validPuzzles = () => PUZZLES.filter(puzzleOk);
function polar(r, deg) { const t = (deg * Math.PI) / 180; return { x: r * Math.sin(t), y: -r * Math.cos(t) }; }
function buildWheel() {
  const svg = $("#wheel");
  const defs = svgEl("defs");
  defs.innerHTML = '<radialGradient id="rim" cx="50%" cy="50%" r="50%"><stop offset="86%" stop-color="#2a2f45"/><stop offset="100%" stop-color="#0d0f19"/></radialGradient>' +
    '<radialGradient id="hubg" cx="40%" cy="35%" r="70%"><stop offset="0%" stop-color="#fff7d6"/><stop offset="70%" stop-color="#f2b705"/><stop offset="100%" stop-color="#a77a00"/></radialGradient>' +
    '<radialGradient id="shine" cx="35%" cy="25%" r="75%"><stop offset="0%" stop-color="#ffffff" stop-opacity=".22"/><stop offset="60%" stop-color="#ffffff" stop-opacity="0"/></radialGradient>';
  svg.append(defs);
  svg.append(svgEl("circle", { cx: 0, cy: 0, r: 208, fill: "url(#rim)" }));
  const g = svgEl("g", { id: "wheel-rot" });
  const r = 190;
  WEDGES.forEach((w, i) => {
    const a0 = i * SEG, a1 = (i + 1) * SEG, p0 = polar(r, a0), p1 = polar(r, a1);
    g.append(svgEl("path", { d: `M0 0 L${p0.x.toFixed(2)} ${p0.y.toFixed(2)} A${r} ${r} 0 0 1 ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} Z`, fill: w.color, stroke: "#ffffff", "stroke-width": "2.5" }));
    const t = svgEl("text", {
      transform: `rotate(${a0 + SEG / 2}) translate(0,-${w.kind === "value" ? 142 : 116}) rotate(-90)`,
      "text-anchor": "middle", "dominant-baseline": "central", fill: w.ink,
      "font-size": w.kind === "value" ? "25" : "13.5", "font-weight": "900", "font-family": "system-ui, sans-serif", "letter-spacing": w.kind === "value" ? "0" : ".5"
    });
    t.textContent = w.label;
    g.append(t);
  });
  g.append(svgEl("circle", { cx: 0, cy: 0, r: 190, fill: "url(#shine)" }));
  g.append(svgEl("circle", { cx: 0, cy: 0, r: 34, fill: "url(#hubg)", stroke: "#3a2c00", "stroke-width": "3" }));
  const hub = svgEl("text", { x: 0, y: 1, "text-anchor": "middle", "dominant-baseline": "central", "font-size": "15", "font-weight": "900", fill: "#2b2100", "font-family": "system-ui, sans-serif" });
  hub.textContent = "SAB";
  g.append(hub);
  svg.append(g);
  // Rim lights (static, blink while spinning)
  for (let i = 0; i < 32; i++) { const p = polar(199, i * 11.25 + 5.625); svg.append(svgEl("circle", { class: "rim-light", cx: p.x.toFixed(2), cy: p.y.toFixed(2), r: 3.6 })); }
