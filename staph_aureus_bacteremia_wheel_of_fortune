<body data-view="start">
<header class="topbar">
  <div class="brand"><span class="brand-mark" aria-hidden="true"></span><span>SAB Wheel</span><span class="brand-sub" id="brand-sub"></span></div>
  <div class="hostbar" role="toolbar" aria-label="Display controls">
    <button id="btn-text-dn" type="button" aria-label="Smaller text">A−</button>
    <button id="btn-text-up" type="button" aria-label="Larger text">A+</button>
    <button id="btn-theme" type="button">Theme: Auto</button>
    <button id="btn-sound" type="button" aria-pressed="true">Sound: On</button>
    <button id="btn-full" type="button">Full screen</button>
    <button id="btn-keys" type="button" aria-expanded="false" aria-controls="keys-pop">Keys</button>
  </div>
</header>
<div id="keys-pop" class="card keys-pop" role="dialog" aria-label="Keyboard shortcuts" hidden>
  <h3>Keyboard shortcuts</h3>
  <dl>
    <dt><kbd>Enter</kbd></dt><dd>Main action: spin, lock in, continue</dd>
    <dt><kbd>1</kbd>–<kbd>4</kbd></dt><dd>Choose an answer option</dd>
    <dt><kbd>A</kbd>–<kbd>E</kbd> then <kbd>1</kbd>–<kbd>5</kbd></dt><dd>Match questions: pick an item, then its match</dd>
    <dt><kbd>A</kbd>–<kbd>Z</kbd></dt><dd>Call a letter (letter screen)</dd>
    <dt><kbd>←</kbd> <kbd>→</kbd> <kbd>Space</kbd></dt><dd>Rapid Pearls: move and flip</dd>
    <dt><kbd>Esc</kbd></dt><dd>Close this panel</dd>
  </dl>
</div>
<div id="bank-errors" class="error-banner" role="alert" hidden></div>

<main>
  <!-- ============ START ============ -->
  <section id="screen-start" aria-labelledby="start-title">
    <div class="hero">
      <div class="card">
        <h1 id="start-title" class="hero-title">Spin. Answer.<br><span>Solve the board.</span></h1>
        <p class="hero-sub" id="start-topic"></p>
        <div class="stat-row" id="start-stats"></div>
        <div class="form-grid">
          <div class="field team-field a"><label for="teamA">Team 1</label><input id="teamA" type="text" value="Team Cocci" maxlength="22"></div>
          <div class="field team-field b"><label for="teamB">Team 2</label><input id="teamB" type="text" value="Team Clusters" maxlength="22"></div>
          <div class="field"><span class="small" style="font-weight:750" id="lbl-puzzles">Puzzles to play</span><div class="seg" role="group" aria-labelledby="lbl-puzzles" id="seg-puzzles"></div></div>
          <div class="field"><span class="small" style="font-weight:750" id="lbl-timer">Question timer</span><div class="seg" role="group" aria-labelledby="lbl-timer" id="seg-timer"></div></div>
          <div class="field full"><span class="small" style="font-weight:750" id="lbl-pool">Question pool</span><div class="seg" role="group" aria-labelledby="lbl-pool" id="seg-pool"></div></div>
        </div>
        <div class="actions" style="margin-top:1.2rem">
          <button id="btn-start" class="btn-primary btn-xl" type="button">Start game</button>
          <button id="btn-pearls" class="btn-lg" type="button">Rapid Pearls review</button>
        </div>
      </div>
      <div class="card">
        <h2>How to play</h2>
        <div class="rules">
          <div class="rule"><b>1 · Spin</b><span>Bigger wedges pull harder questions (●○○ to ●●●).</span></div>
          <div class="rule"><b>2 · Answer</b><span>Talk it over as a team, then lock in.</span></div>
          <div class="rule"><b>3 · Call a letter</b><span>Correct = bank the wedge + call a letter. Consonants +50 each. Vowels cost 100.</span></div>
          <div class="rule"><b>4 · Steal</b><span>Miss, and the other team can steal for half.</span></div>
          <div class="rule"><b>5 · Solve</b><span>Solve on your turn for +500. Both teams bank that puzzle's points.</span></div>
          <div class="rule"><b>Special wedges</b><span><i class="wedge-dot" style="background:#111"></i>Bankrupt · <i class="wedge-dot" style="background:#f2f2f2"></i>Lose a turn · <i class="wedge-dot" style="background:#ffd23f"></i>Steal / Double · <i class="wedge-dot" style="background:#14a3b8"></i>Free spin</span></div>
        </div>
        <p class="small muted" style="margin-top:1rem">Mixed-level tip: rotate who reads the question and who calls the final answer each turn.</p>
      </div>
    </div>
  </section>

  <!-- ============ GAME ============ -->
  <section id="screen-game" hidden aria-label="Game">
    <div class="arena">
      <div class="team" data-team="0" id="team-0" aria-live="polite"></div>
      <div class="board" aria-label="Puzzle board">
        <div class="cat"><span id="puzzle-cat"></span></div>
        <div class="words" id="puzzle-words" aria-hidden="true"></div>
        <p class="sr-only" id="puzzle-sr"></p>
        <div class="used-letters" id="used-letters"></div>
      </div>
      <div class="team" data-team="1" id="team-1" aria-live="polite"></div>
    </div>
    <div class="stage">
      <div id="view-wheel" class="wheel-view">
        <div class="wheel-box"><svg id="wheel" viewBox="-212 -222 424 434" role="img" aria-label="Prize wheel"></svg></div>
        <div class="wheel-side">
          <div class="turn-callout" id="turn-callout"></div>
          <div id="landed-slot"></div>
          <p class="message" id="wheel-msg" role="status"></p>
          <div class="side-actions">
            <button id="btn-spin" class="btn-primary btn-xl" type="button">Spin the wheel</button>
            <button id="btn-solve" class="btn-lg" type="button">Solve the puzzle</button>
          </div>
          <div class="legend" aria-hidden="true"><span>●○○ 100–200</span><span>●●○ 300–400</span><span>●●● 500+, Double</span></div>
        </div>
      </div>
      <div id="view-question" class="panel" hidden></div>
      <div id="view-letters" class="panel" hidden></div>
      <div id="view-solve" class="panel" hidden></div>
    </div>
    <div class="game-foot">
      <span id="q-left"></span>
      <button id="btn-end" class="btn-ghost" type="button">End game</button>
    </div>
  </section>

  <!-- ============ END ============ -->
  <section id="screen-end" hidden aria-labelledby="winner">
    <div class="card winner-card">
      <p class="small muted" style="font-weight:800;letter-spacing:.12em;text-transform:uppercase">Final results</p>
      <h1 class="winner" id="winner"></h1>
      <div class="finals" id="finals"></div>
      <p class="muted" id="end-note"></p>
      <div class="actions" style="justify-content:center">
        <button id="btn-retry" class="btn-primary btn-lg" type="button">Retry missed</button>
        <button id="btn-copy" class="btn-lg" type="button">Copy results</button>
        <button id="btn-again" class="btn-lg" type="button">New game</button>
      </div>
      <p id="copy-status" class="small" role="status" style="margin-top:.6rem"></p>
    </div>
    <div class="end-grid">
      <div class="card"><h2>By domain <span class="small muted">(correct / attempted)</span></h2><div class="table-wrap" id="tbl-domain"></div></div>
      <div class="card"><h2>By Bloom level <span class="small muted">(correct / attempted)</span></h2><div class="table-wrap" id="tbl-bloom"></div></div>
    </div>
    <div class="card" style="margin-top:1rem"><h2>Missed on first attempt</h2><div id="missed-list"></div></div>
  </section>

  <!-- ============ RETRY MISSED ============ -->
  <section id="screen-review" hidden aria-labelledby="review-title">
    <div class="panel">
      <div class="qhead"><h2 id="review-title" style="margin:0">Retry missed</h2><span class="chip" id="review-progress"></span></div>
      <div id="review-body"></div>
    </div>
  </section>

  <!-- ============ RAPID PEARLS ============ -->
  <section id="screen-pearls" hidden aria-labelledby="pearls-title">
    <div class="qhead"><h2 id="pearls-title" style="margin:0;font-size:1.8rem">Rapid Pearls</h2><span class="chip" id="pearl-progress"></span></div>
    <div class="flip-wrap"><button id="pearl-card" class="flip-card" type="button" aria-pressed="false"><div class="face front" id="pearl-front"></div><div class="face back" id="pearl-back"></div></button></div>
    <div class="actions" style="justify-content:center;margin-top:1rem">
      <button id="pearl-prev" class="btn-lg" type="button">← Previous</button>
      <button id="pearl-flip" class="btn-primary btn-lg" type="button">Flip</button>
      <button id="pearl-next" class="btn-lg" type="button">Next →</button>
      <button id="pearl-exit" class="btn-ghost btn-lg" type="button">Back to start</button>
    </div>
  </section>

  <div id="announcer" class="sr-only" aria-live="polite"></div>
</main>
