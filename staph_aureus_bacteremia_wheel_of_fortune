  const colors = ["#d9362f", "#f2b705", "#1f8a4c", "#2563c9", "#7e3fb8", "#14a3b8", "#c42a6e"];
  const parts = range(170).map(() => ({ x: Math.random() * c.width, y: -20 - Math.random() * c.height * 0.5, w: 6 + Math.random() * 8, h: 8 + Math.random() * 10, vy: 2 + Math.random() * 3.5, vx: -1.5 + Math.random() * 3, r: Math.random() * 6, vr: -0.15 + Math.random() * 0.3, col: colors[Math.floor(Math.random() * colors.length)] }));
