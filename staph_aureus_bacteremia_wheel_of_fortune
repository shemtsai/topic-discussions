    const lost = team.round; team.round = 0; Sound.bankrupt();
    if (lost) popScore(state.active, `−${fmt(lost)}`, false);
    return passTurn(`BANKRUPT! ${team.name} loses ${fmt(lost)} puzzle points.`, w);
  }
  if (w.kind === "lose") { Sound.wrong(); return passTurn(`LOSE A TURN for ${team.name}.`, w); }
  if (w.kind === "free") { Sound.ding(); showWheel(`FREE SPIN! ${team.name}, spin again.`); $("#landed-slot").append(landedChip(w)); return; }
  if (w.kind === "value") return askQuestion({ kind: "value", value: w.value, label: w.label, wedge: w, target: w.value <= 200 ? 1 : w.value <= 400 ? 2 : 3 });
  if (w.kind === "steal") return askQuestion({ kind: "steal", label: "STEAL", wedge: w, target: 2 });
  if (w.kind === "double") return askQuestion({ kind: "double", label: "DOUBLE", wedge: w, target: 3 });
