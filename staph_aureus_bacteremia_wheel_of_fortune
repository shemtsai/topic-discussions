/* Picks an unused item closest to the target difficulty. */
function pickItem(target) {
  const unused = state.pool.filter((it) => !state.used.has(it.id));
  for (let d = 0; d <= 2; d++) { const c = unused.filter((it) => Math.abs(it.difficulty - target) === d); if (c.length) return c[Math.floor(Math.random() * c.length)]; }
  return null;
}
function askQuestion(ctx) {
  const item = pickItem(ctx.target);
  if (!item) return endGame("Question bank exhausted.");
  state.used.add(item.id);
  state.q = { item, ctx, team: state.active, attempt: 0, picks: [], order: null };
  renderQuestion();
}
function prizeText(ctx, steal) {
  if (ctx.kind === "value") return steal ? `${fmt(Math.floor(ctx.value * RULES.stealFraction))} pts` : `${fmt(ctx.value)} pts + a letter`;
  if (steal) return `${RULES.stealOnSpecial} pts`;
  return ctx.kind === "steal" ? `steal up to ${RULES.stealWedgeMax} pts` : "double your puzzle points";
}

function renderQuestion() {
  const q = state.q, item = q.item;
  const answering = q.attempt === 0 ? q.team : 1 - q.team;
  setView("question");
  const v = $("#view-question");
  v.innerHTML = "";
  const stars = "●".repeat(item.difficulty) + "○".repeat(3 - item.difficulty);
  const ring = el("div", { class: "timer-ring", id: "timer", hidden: !state.settings.timer, "aria-label": "Time remaining" });
  ring.innerHTML = '<svg viewBox="0 0 40 40" aria-hidden="true"><circle class="trk" cx="20" cy="20" r="17" fill="none" stroke-width="4"/><circle class="bar" cx="20" cy="20" r="17" fill="none" stroke-width="4" stroke-linecap="round" stroke-dasharray="106.8" stroke-dashoffset="0"/></svg><span></span>';
  v.append(el("div", { class: "qhead" },
    el("div", { class: "row" },
      el("span", { class: "who", "data-team": String(answering) }, q.attempt ? `STEAL: ${state.teams[answering].name}` : state.teams[answering].name),
      el("span", { class: "landed", style: `background:${q.ctx.wedge.color};color:${q.ctx.wedge.ink};font-size:1rem` }, q.ctx.label),
      el("span", { class: "prize" }, `for ${prizeText(q.ctx, q.attempt === 1)}`)),
    el("div", { class: "row" },
      el("span", { class: "chip" }, item.domain),
      el("span", { class: "chip", "aria-label": `Difficulty ${item.difficulty} of 3` }, el("span", { class: "stars", "aria-hidden": "true" }, stars)),
      ring)));
