  q.locked = true;
  const other = state.teams[1 - q.team];
  const acts = $("#q-actions");
  acts.innerHTML = "";
  const stealBtn = el("button", { class: "btn-gold btn-xl", type: "button" }, `${other.name}: steal!`);
  const skipBtn = el("button", { class: "btn-lg", type: "button" }, "No steal, reveal answer");
