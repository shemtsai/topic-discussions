/* =====================================================================
   TURN FLOW
   ===================================================================== */
function landedChip(w) { return el("span", { class: "landed", style: `background:${w.color};color:${w.ink}` }, `Landed: ${w.kind === "value" ? w.label + " pts" : w.label}`); }
function onLand(idx) {
