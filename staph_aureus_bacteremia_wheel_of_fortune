/* =====================================================================
   VALIDATOR: checks every item; invalid IDs are listed on screen and
   excluded. Returns [{id, msg}].
   ===================================================================== */
function validateBank(bank) {
  const errors = [];
  if (!bank || !Array.isArray(bank.items)) return [{ id: "(BANK)", msg: "BANK.items is missing or not an array" }];
  const seen = new Set();
  const isStr = (x) => typeof x === "string" && x.trim() !== "";
  bank.items.forEach((it, i) => {
    const id = it && isStr(it.id) ? it.id : `(item #${i + 1})`;
    const e = [];
    if (!it || typeof it !== "object") { errors.push({ id, msg: "not an object" }); return; }
    ["id", "type", "domain", "bloom", "stem", "pearl", "status"].forEach((f) => { if (!isStr(it[f])) e.push(`missing ${f}`); });
    if (seen.has(id)) e.push("duplicate id");
    seen.add(id);
    if (!["mcq", "case_mcq", "match", "order"].includes(it.type)) e.push(`invalid type "${it.type}"`);
    if (!["recall", "apply", "analyze"].includes(it.bloom)) e.push(`invalid bloom "${it.bloom}"`);
    if (![1, 2, 3].includes(it.difficulty)) e.push("difficulty must be 1, 2, or 3");
    if (!["ready", "hold"].includes(it.status)) e.push(`invalid status "${it.status}"`);
    if (!it.rationale || !isStr(it.rationale.correct)) e.push("missing rationale.correct");
    if (!it.source || !["handout", "pearl_cited", "pearl_uncited"].includes(it.source.type)) e.push("invalid source.type");
    else if (it.source.type === "handout" && !isStr(it.source.locator)) e.push("handout source needs a locator");
    else if (it.source.type === "pearl_cited" && !isStr(it.source.citation)) e.push("pearl_cited source needs a citation");
    if (MCQ_TYPES.includes(it.type)) {
      if (!Array.isArray(it.options) || it.options.length !== 4 || !it.options.every(isStr)) e.push("needs exactly 4 non-empty options");
      if (!Number.isInteger(it.answer_index) || it.answer_index < 0 || it.answer_index > 3) e.push("answer_index must be 0-3");
      if (!it.rationale || !Array.isArray(it.rationale.distractors) || it.rationale.distractors.length !== 3) e.push("needs 3 distractor rationales");
      if (Array.isArray(it.options) && new Set(it.options).size !== it.options.length) e.push("duplicate options");
    }
    if (it.type === "match") {
      if (!Array.isArray(it.pairs) || it.pairs.length < 2 || it.pairs.length > 8 || !it.pairs.every((p) => Array.isArray(p) && p.length === 2 && isStr(p[0]) && isStr(p[1]))) e.push("pairs must be 2-8 [left, right] string pairs");
      else if (new Set(it.pairs.map((p) => p[1])).size !== it.pairs.length) e.push("right-side match values must be unique");
    }
    if (it.type === "order") {
      if (!Array.isArray(it.sequence) || it.sequence.length < 2 || !it.sequence.every(isStr)) e.push("sequence must have 2+ steps");
      else if (new Set(it.sequence).size !== it.sequence.length) e.push("sequence steps must be unique");
    }
    if (e.length) errors.push({ id, msg: e.join("; ") });
  });
  return errors;
}

/* =====================================================================
   ITEM RENDERERS. Each returns a controller:
   { isComplete(), isCorrect(), disable(), markFeedback(picks) }
   MCQ options are shuffled at render. ctl.order[displayPos] = original
   index, so correctness is always checked against the ORIGINAL
   answer_index. Shuffling cannot change which option is correct.
   ===================================================================== */
function renderItem(host, item, opts = {}) {
  host.innerHTML = "";
  const stemId = `stem-${item.id}-${Math.random().toString(36).slice(2, 7)}`;
  host.append(el("p", { class: "stem", id: stemId }, item.stem));
  const ctl = { item, disabled: false, onChange: opts.onChange || (() => {}) };
  if (MCQ_TYPES.includes(item.type)) renderMcq(host, item, opts, ctl, stemId);
  else if (item.type === "match") renderMatch(host, item, ctl, stemId);
  else renderOrder(host, item, ctl, stemId);
  return ctl;
}

function renderMcq(host, item, opts, ctl, stemId) {
  ctl.order = opts.order || shuffle(range(item.options.length));
  ctl.response = null;
  const elim = opts.eliminated || [];
  const grid = el("div", { class: "options", role: "radiogroup", "aria-labelledby": stemId });
  ctl.buttons = ctl.order.map((orig, pos) => {
    const out = elim.includes(orig);
    const b = el("button", { type: "button", class: "opt" + (out ? " eliminated" : ""), role: "radio", "aria-checked": "false", disabled: out },
      el("span", { class: "keycap", "aria-hidden": "true" }, String(pos + 1)),
      el("span", { class: "opt-text" }, item.options[orig]),
      out ? el("span", { class: "mark bad" }, "✗ Ruled out") : null);
    b.addEventListener("click", () => ctl.select(pos));
    grid.append(b);
    return b;
  });
  host.append(grid);
  ctl.select = (pos) => {
    if (ctl.disabled || !ctl.buttons[pos] || ctl.buttons[pos].disabled) return;
    ctl.response = pos;
    ctl.buttons.forEach((b, i) => { b.setAttribute("aria-checked", String(i === pos)); b.classList.toggle("selected", i === pos); });
    ctl.onChange();
  };
  ctl.isComplete = () => ctl.response !== null;
  ctl.pickedOriginal = () => (ctl.response === null ? null : ctl.order[ctl.response]);
  ctl.isCorrect = () => ctl.response !== null && ctl.order[ctl.response] === item.answer_index;
  ctl.disable = () => { ctl.disabled = true; ctl.buttons.forEach((b) => (b.disabled = true)); };
  // Marks the correct option and every wrong pick (picks = original indices).
  ctl.markFeedback = (picks) => {
    ctl.buttons.forEach((b, pos) => {
      const orig = ctl.order[pos];
      b.classList.remove("selected", "eliminated");
      b.querySelectorAll(".mark").forEach((m) => m.remove());
      if (orig === item.answer_index) { b.classList.add("is-answer"); b.append(el("span", { class: "mark ok" }, "✓ Correct")); }
      else if (picks.includes(orig)) { b.classList.add("is-wrong"); b.append(el("span", { class: "mark bad" }, "✗ Picked")); }
    });
  };
}

/* Match: tap-to-pair. Left items are lettered (A, B, C…), right items are
   numbered (1, 2, 3…) and shuffled. Everything stays visible on screen;
   each pairing shows the letter on its match, in the same color. */
function renderMatch(host, item, ctl, stemId) {
  const n = item.pairs.length;
  const rOrder = shuffle(range(n)); // display position -> original right index
  ctl.rOrder = rOrder;
  ctl.assign = new Array(n).fill(null); // left i -> original right index
  ctl.active = 0;
  const wrap = el("div", { class: "match", role: "group", "aria-labelledby": stemId });
  const left = el("div", { class: "match-col" }, el("div", { class: "col-head" }, "Pick an item"));
  const right = el("div", { class: "match-col" }, el("div", { class: "col-head" }, "Then tap its match"));
  ctl.leftBtns = item.pairs.map((p, i) => {
    const b = el("button", { type: "button", class: "m-card m-left", style: `--pc:${PAIR_COLORS[i % PAIR_COLORS.length]}` },
      el("span", { class: "letter-chip", "aria-hidden": "true" }, LETTERS[i]), el("span", { class: "m-text" }, p[0]), el("span", { class: "m-slot" }, "?"));
    b.addEventListener("click", () => ctl.selectLeft(i));
    left.append(b);
    return b;
  });
  ctl.rightBtns = rOrder.map((ri, pos) => {
    const b = el("button", { type: "button", class: "m-card m-right" },
      el("span", { class: "keycap", "aria-hidden": "true" }, String(pos + 1)), el("span", { class: "m-text" }, item.pairs[ri][1]), el("span", { class: "m-slot" }, ""));
    b.addEventListener("click", () => ctl.pickRight(pos));
    right.append(b);
    return b;
  });
  wrap.append(left, right);
  host.append(wrap);
  const paint = () => {
    ctl.leftBtns.forEach((b, i) => {
      const a = ctl.assign[i];
      b.classList.toggle("active", i === ctl.active && !ctl.disabled);
      b.classList.toggle("filled", a !== null);
      b.setAttribute("aria-pressed", String(i === ctl.active));
      b.querySelector(".m-slot").textContent = a === null ? "?" : String(rOrder.indexOf(a) + 1);
      b.setAttribute("aria-label", `${LETTERS[i]}: ${item.pairs[i][0]}. ${a === null ? "Not matched yet" : "Matched to " + (rOrder.indexOf(a) + 1)}`);
    });
    ctl.rightBtns.forEach((b, pos) => {
      const ri = rOrder[pos], owner = ctl.assign.indexOf(ri), slot = b.querySelector(".m-slot");
      slot.innerHTML = "";
      b.classList.toggle("taken", owner !== -1);
      b.style.setProperty("--pc", owner === -1 ? "var(--line)" : PAIR_COLORS[owner % PAIR_COLORS.length]);
      if (owner !== -1) slot.append(el("span", { class: "letter-chip", style: `--pc:${PAIR_COLORS[owner % PAIR_COLORS.length]}` }, LETTERS[owner]));
      b.setAttribute("aria-label", `${pos + 1}: ${item.pairs[ri][1]}${owner !== -1 ? ". Matched with " + LETTERS[owner] : ""}`);
    });
  };
  // Pair left i with original right index ri; a right card can only belong to one left item.
  ctl.setPair = (li, ri) => {
    if (ctl.disabled) return;
    ctl.assign.forEach((v, k) => { if (v === ri) ctl.assign[k] = null; });
    ctl.assign[li] = ri;
    const next = ctl.assign.findIndex((v) => v === null);
    ctl.active = next === -1 ? li : next;
    paint();
    announce(`${LETTERS[li]} matched to ${rOrder.indexOf(ri) + 1}`);
    ctl.onChange();
  };
  ctl.selectLeft = (i) => { if (ctl.disabled || i < 0 || i >= n) return; ctl.active = i; paint(); };
