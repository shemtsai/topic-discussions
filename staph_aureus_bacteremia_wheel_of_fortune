  const host = el("div");
  body.append(host);
  const lock = el("button", { class: "btn-primary btn-xl", type: "button", disabled: true }, "Lock in answer");
  const ctl = renderItem(host, item, { onChange: () => (lock.disabled = !ctl.isComplete()) });
  state.reviewCtl = ctl;
  lock.disabled = !ctl.isComplete();
  const acts = el("div", { class: "actions" }, lock);
  body.append(acts);
  lock.addEventListener("click", () => {
    const ok = ctl.isComplete() && ctl.isCorrect();
    if (ok) { review.correct++; Sound.correct(); } else Sound.wrong();
    ctl.disable();
    ctl.markFeedback(MCQ_TYPES.includes(item.type) && ctl.pickedOriginal() !== null ? [ctl.pickedOriginal()] : []);
    acts.remove();
    const fb = renderFeedback(item, ok, ok ? "Correct!" : "Not quite.");
    body.append(fb);
    const next = el("button", { class: "btn-primary btn-xl", type: "button" }, "Next →");
    next.addEventListener("click", () => { review.i++; renderReviewItem(); });
    body.append(el("div", { class: "actions", style: "margin-top:1rem" }, next));
    setPrimary(next); scrollIntoViewSafe(fb);
  });
  setPrimary(lock);
}

/* =====================================================================
   RAPID PEARLS (flip cards)
   ===================================================================== */
const pearls = { cards: [], i: 0, flipped: false };
function startPearls() {
  pearls.cards = shuffle(state.ready); pearls.i = 0; pearls.flipped = false;
  state.view = "pearls";
  show("#screen-pearls");
  $("#pearl-card").onclick = flipPearl;
  $("#pearl-flip").onclick = flipPearl;
  $("#pearl-prev").onclick = () => movePearl(-1);
  $("#pearl-next").onclick = () => movePearl(1);
  $("#pearl-exit").onclick = () => { state.view = "start"; show("#screen-start"); setPrimary($("#btn-start")); };
  renderPearl();
  setPrimary($("#pearl-flip"));
  $("#pearl-card").focus();
}
function renderPearl() {
  const c = pearls.cards[pearls.i], card = $("#pearl-card");
  const front = $("#pearl-front"), back = $("#pearl-back");
  front.innerHTML = ""; back.innerHTML = "";
  const stem = c.stem.length > 320 ? c.stem.slice(0, 317) + "…" : c.stem;
  front.append(el("span", { class: "side-label" }, `Card ${pearls.i + 1} · ${c.domain}`), el("span", { class: "front-text" }, stem), el("span", { class: "muted", style: "margin-top:1.2rem;font-weight:700" }, "What's the takeaway? Tap to flip."));
  back.append(el("span", { class: "side-label" }, "Pearl"), el("span", { class: "back-text" }, c.pearl), el("span", { style: "margin-top:1.2rem" }, sourceBadge(c)));
  card.classList.toggle("flipped", pearls.flipped);
  card.setAttribute("aria-pressed", String(pearls.flipped));
  card.setAttribute("aria-label", pearls.flipped ? `Pearl: ${c.pearl}` : `Card ${pearls.i + 1}, ${c.domain}. ${c.stem}. Press to reveal the pearl.`);
  front.setAttribute("aria-hidden", String(pearls.flipped)); back.setAttribute("aria-hidden", String(!pearls.flipped));
  $("#pearl-progress").textContent = `${pearls.i + 1} of ${pearls.cards.length}`;
}
function flipPearl() { pearls.flipped = !pearls.flipped; renderPearl(); announce(pearls.flipped ? pearls.cards[pearls.i].pearl : "Front"); }
function movePearl(d) { pearls.i = (pearls.i + d + pearls.cards.length) % pearls.cards.length; pearls.flipped = false; renderPearl(); }

/* =====================================================================
   KEYBOARD: 1-9 choose MCQ option / match target, A-H pick match item,
   Enter = main action, A-Z call a letter, arrows/space in Rapid Pearls.
   ===================================================================== */
function onKey(e) {
  if (e.key === "Escape" && !$("#keys-pop").hidden) { $("#keys-pop").hidden = true; $("#btn-keys").setAttribute("aria-expanded", "false"); $("#btn-keys").focus(); return; }
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  const t = e.target, tag = t && t.tagName;
  if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
  if (state.view === "pearls" && !$("#screen-pearls").hidden) {
    if (e.key === "ArrowRight") { movePearl(1); e.preventDefault(); }
    else if (e.key === "ArrowLeft") { movePearl(-1); e.preventDefault(); }
    else if ((e.key === " " || e.key === "Enter") && !(tag === "BUTTON" && t.id !== "pearl-card")) { flipPearl(); e.preventDefault(); }
    return;
  }
  const ctl = state.view === "question" && state.q && !state.q.locked ? state.q.ctl : state.view === "review" && state.reviewCtl && !state.reviewCtl.disabled ? state.reviewCtl : null;
  if (ctl && /^[1-9]$/.test(e.key)) {
    if (ctl.select) ctl.select(Number(e.key) - 1); else if (ctl.pickRight) ctl.pickRight(Number(e.key) - 1);
    e.preventDefault(); return;
  }
  if (ctl && ctl.selectLeft && /^[a-hA-H]$/.test(e.key)) { ctl.selectLeft(LETTERS.indexOf(e.key.toUpperCase())); e.preventDefault(); return; }
  if (state.view === "letters" && /^[a-zA-Z]$/.test(e.key)) { guessLetter(state.letterTeam, e.key.toUpperCase()); e.preventDefault(); return; }
  if (e.key === "Enter" && state.primary && !state.primary.disabled && !state.primary.closest("[hidden]")) {
    // Enter on an answer card, or with nothing focused, triggers the main action.
    if (tag !== "BUTTON" || t.classList.contains("opt") || t.classList.contains("m-card")) { e.preventDefault(); state.primary.click(); }
  }
}

/* Debug/test hooks (read-only use). */
window.SABWheel = { BANK, PUZZLES, WEDGES, RULES, state, validateBank, renderItem, shuffle, wedgeUnderPointer, targetAngleFor, onLand, lockIn, finishQuestion, guessLetter, openSolve, solvePuzzle, computeStats, missedEntries, resultsText, startGame, endGame };

init();
