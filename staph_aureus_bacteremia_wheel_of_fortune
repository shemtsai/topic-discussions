    const c = ac(); if (!c) return;
    const t = c.currentTime + (when || 0), o = c.createOscillator(), g = c.createGain();
    o.type = type || "sine"; o.frequency.setValueAtTime(freq, t);
    g.gain.setValueAtTime(gain || 0.07, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(c.destination); o.start(t); o.stop(t + dur + 0.02);
  }
  return {
    isOn: () => on, setOn: (v) => { on = v; },
    tick: () => tone(1500, 0.025, "square", 0.025),
    correct: () => [660, 880, 1320].forEach((f, i) => tone(f, 0.2, "triangle", 0.09, i * 0.09)),
