}

/* Order: big rows with move up/down. ctl.arr holds original step indices
   in displayed order; correct when arr[i] === i. */
function renderOrder(host, item, ctl, stemId) {
  let arr = shuffle(range(item.sequence.length));
  while (arr.every((v, i) => v === i)) arr = shuffle(range(item.sequence.length));
  ctl.arr = arr;
  const ol = el("ol", { class: "order-list", "aria-labelledby": stemId });
  host.append(el("p", { class: "small muted", style: "margin-top:-.4rem" }, "Use the arrows to put the steps in order (first at top)."), ol);
  const draw = (focusPos, dir) => {
    ol.innerHTML = "";
    ctl.arr.forEach((orig, pos) => {
      const txt = item.sequence[orig];
      const up = el("button", { type: "button", "aria-label": `Move up: ${txt}`, disabled: pos === 0 || ctl.disabled }, "▲");
      const dn = el("button", { type: "button", "aria-label": `Move down: ${txt}`, disabled: pos === ctl.arr.length - 1 || ctl.disabled }, "▼");
      up.addEventListener("click", () => move(pos, -1));
      dn.addEventListener("click", () => move(pos, 1));
      const li = el("li", { class: focusPos === pos ? "moved" : "" }, el("span", { class: "pos", "aria-hidden": "true" }, String(pos + 1)), el("span", { class: "txt" }, txt), up, dn);
      if (ctl.marked) li.classList.add(orig === pos ? "is-answer" : "is-wrong");
      ol.append(li);
