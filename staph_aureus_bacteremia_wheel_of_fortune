  const ptr = svgEl("g", { id: "pointer" });
  ptr.append(svgEl("path", { d: "M-19 -220 L19 -220 L0 -172 Z", fill: "#f2b705", stroke: "#1a1400", "stroke-width": "3.5", "stroke-linejoin": "round" }));
  ptr.append(svgEl("circle", { cx: 0, cy: -212, r: 5, fill: "#1a1400" }));
  svg.append(ptr);
}
function wedgeUnderPointer(angle) { const a = (((-angle) % 360) + 360) % 360; return Math.floor(a / SEG) % WEDGES.length; }
/* Picks the landing wedge first, then a rotation that lands inside it
   (with jitter, never on a border), so the result is uniform and exact. */
function targetAngleFor(idx, current) {
  const jitter = (Math.random() - 0.5) * SEG * 0.7;
  const a = idx * SEG + SEG / 2 + jitter;
  const delta = ((((-a) - current) % 360) + 360) % 360;
  return current + 360 * (4 + Math.floor(Math.random() * 2)) + delta;
}
function spin() {
  if (state.spinning || state.view !== "wheel") return;
  state.spinning = true;
  $("#btn-spin").disabled = true; $("#btn-solve").disabled = true;
  $("#wheel-msg").textContent = "Spinning…";
  $("#landed-slot").innerHTML = "";
  const svg = $("#wheel"); svg.classList.add("spinning");
  const idx = Math.floor(Math.random() * WEDGES.length);
