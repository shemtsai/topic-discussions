<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SAB Wheel</title>
<style>
/* =====================================================================
   THEME TOKENS. Light by default; dark follows the OS unless the host
   picks a theme with the Theme button (data-theme on <html>).
   ===================================================================== */
:root{
  --scale:1;
  --bg:#f3efe6; --bg-2:#e9e3d6; --surface:#ffffff; --surface-2:#f6f3ec; --ink:#14161c; --muted:#4f5665;
  --line:#d8d1c3; --accent:#1d4ed8; --accent-ink:#ffffff; --gold:#f2b705; --gold-ink:#1a1400;
  --ok:#137a3a; --ok-bg:#e1f4e7; --bad:#b4231a; --bad-bg:#fbe3e0;
  --teamA:#1d5fd6; --teamA-bg:#e6eeff; --teamB:#b8420b; --teamB-bg:#fff0e6;
  --board:#0f3b33; --board-2:#0b2d27; --tile:#1f7a65; --tile-ink:#ffffff; --tile-hidden:#f7f5ee; --tile-edge:#c9c2b0;
  --shadow:0 1px 2px rgba(20,22,28,.06),0 8px 24px rgba(20,22,28,.08);
  --focus:#f59e0b; --radius:18px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0b0e1c; --bg-2:#11152a; --surface:#161a31; --surface-2:#1e2340; --ink:#eef1fa; --muted:#aab2c8;
    --line:#2c3356; --accent:#7ea6ff; --accent-ink:#0a1124; --gold:#ffcd3c; --gold-ink:#1a1400;
    --ok:#62d98f; --ok-bg:#12301f; --bad:#ff8b82; --bad-bg:#3a1714;
    --teamA:#7db3ff; --teamA-bg:#16264a; --teamB:#ffa66b; --teamB-bg:#3a2214;
    --board:#0a2a24; --board-2:#071f1a; --tile:#23947a; --tile-ink:#ffffff; --tile-hidden:#eef2ea; --tile-edge:#0c3a31;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35);
  }
}
:root[data-theme="dark"]{
  --bg:#0b0e1c; --bg-2:#11152a; --surface:#161a31; --surface-2:#1e2340; --ink:#eef1fa; --muted:#aab2c8;
  --line:#2c3356; --accent:#7ea6ff; --accent-ink:#0a1124; --gold:#ffcd3c; --gold-ink:#1a1400;
  --ok:#62d98f; --ok-bg:#12301f; --bad:#ff8b82; --bad-bg:#3a1714;
  --teamA:#7db3ff; --teamA-bg:#16264a; --teamB:#ffa66b; --teamB-bg:#3a2214;
  --board:#0a2a24; --board-2:#071f1a; --tile:#23947a; --tile-ink:#ffffff; --tile-hidden:#eef2ea; --tile-edge:#0c3a31;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35);
}

/* Fluid root size: ~15px on phones, ~20px on a 1920px projector; A-/A+ scales it. */
html{font-size:calc(var(--scale) * clamp(15px, 0.55vw + 9.5px, 22px))}
*{box-sizing:border-box}
[hidden]{display:none !important}
body{margin:0;background:radial-gradient(1200px 600px at 50% -10%, var(--bg-2), var(--bg));background-color:var(--bg);color:var(--ink);
  font:400 1rem/1.45 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;min-height:100vh;-webkit-text-size-adjust:100%}
h1,h2,h3{margin:0 0 .4em;line-height:1.15;letter-spacing:-.01em}
p{margin:0 0 .7em}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;border:1.5px solid var(--line);background:var(--surface);border-radius:12px;min-height:2.75rem;padding:.55em 1.05em;font-weight:650;transition:transform .08s ease, box-shadow .15s ease, background .15s ease}
button:hover:not(:disabled){box-shadow:var(--shadow)}
button:active:not(:disabled){transform:translateY(1px)}
button:disabled{cursor:not-allowed;opacity:.45}
:focus-visible{outline:4px solid var(--focus);outline-offset:3px}
.btn-primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn-gold{background:var(--gold);border-color:var(--gold);color:var(--gold-ink)}
.btn-ghost{background:transparent}
.btn-xl{font-size:1.45rem;padding:.6em 1.4em;min-height:3.6rem;border-radius:16px;font-weight:800;letter-spacing:.01em}
.btn-lg{font-size:1.12rem;min-height:3.1rem;padding:.55em 1.2em;border-radius:14px}
input[type=text]{width:100%;min-height:3rem;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);padding:.45em .8em;font-size:1.1rem}
select{min-height:3rem;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);padding:.4em .7em;font-size:1.05rem;width:100%}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.muted{color:var(--muted)}
.small{font-size:.9rem}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:1.2rem 1.3rem}
.row{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center}
.chip{display:inline-flex;align-items:center;gap:.35em;border:1px solid var(--line);border-radius:999px;padding:.18em .75em;font-size:.88rem;font-weight:650;background:var(--surface-2);white-space:nowrap}

/* ---------- Top bar ---------- */
.topbar{display:flex;justify-content:space-between;align-items:center;gap:.8rem;flex-wrap:wrap;padding:.7rem 1.2rem;max-width:1800px;margin:0 auto}
.brand{display:flex;align-items:center;gap:.6rem;font-weight:850;font-size:1.25rem;letter-spacing:-.01em}
.brand-mark{width:1.6rem;height:1.6rem;border-radius:50%;background:conic-gradient(#d9362f 0 45deg,#f2b705 0 90deg,#1f8a4c 0 135deg,#2563c9 0 180deg,#7e3fb8 0 225deg,#d9600f 0 270deg,#14a3b8 0 315deg,#c42a6e 0);box-shadow:0 0 0 3px var(--surface),0 0 0 4.5px var(--line)}
.brand-sub{font-weight:600;color:var(--muted);font-size:.9rem}
.hostbar{display:flex;gap:.4rem;flex-wrap:wrap}
.hostbar button{min-height:2.4rem;padding:.3em .75em;font-size:.88rem;background:var(--surface-2)}
.keys-pop{position:fixed;right:1rem;top:4rem;z-index:50;width:min(26rem,92vw)}
.keys-pop dl{display:grid;grid-template-columns:auto 1fr;gap:.35rem .9rem;margin:0}
.keys-pop dt{font-weight:800}
kbd{display:inline-block;min-width:1.6em;text-align:center;border:1px solid var(--line);border-bottom-width:3px;border-radius:7px;padding:.05em .4em;background:var(--surface-2);font:700 .9em/1.3 ui-monospace,Consolas,monospace}

main{max-width:1800px;margin:0 auto;padding:0 1.2rem 1.5rem}
.error-banner{background:var(--bad-bg);color:var(--bad);border:2px solid var(--bad);border-radius:14px;padding:.8rem 1rem;margin:0 auto 1rem;max-width:1800px}
.error-banner ul{margin:.3em 0 0 1.2em;padding:0}

/* ---------- Start screen ---------- */
.hero{display:grid;gap:1.2rem;align-items:stretch}
@media(min-width:960px){.hero{grid-template-columns:1.15fr 1fr}}
.hero-title{font-size:clamp(2.4rem,5vw,4.2rem);font-weight:900;letter-spacing:-.03em;line-height:1}
.hero-title span{background:linear-gradient(90deg,var(--teamA),var(--accent) 40%,var(--teamB));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{font-size:1.15rem;color:var(--muted);margin:.6rem 0 1rem}
.stat-row{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.1rem}
.stat{border:1px solid var(--line);background:var(--surface-2);border-radius:14px;padding:.5rem .9rem}
.stat b{display:block;font-size:1.5rem;line-height:1.1}
.form-grid{display:grid;gap:.9rem;grid-template-columns:1fr 1fr}
.form-grid .full{grid-column:1/-1}
.field{display:grid;gap:.3rem}
.field label{font-weight:750;font-size:.95rem}
.team-field input{border-width:2px}
.team-field.a input{border-color:var(--teamA)}
.team-field.b input{border-color:var(--teamB)}
.seg{display:flex;border:1.5px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface-2)}
.seg button{flex:1;border:0;border-radius:0;min-height:2.9rem;background:transparent;font-weight:700}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.rules{display:grid;gap:.65rem;grid-template-columns:1fr 1fr}
.rule{border:1px solid var(--line);border-radius:14px;padding:.65rem .8rem;background:var(--surface-2)}
.rule b{display:block;font-size:1.02rem}
.rule span{font-size:.9rem;color:var(--muted)}
.wedge-dot{display:inline-block;width:.85em;height:.85em;border-radius:3px;vertical-align:-.08em;margin-right:.35em;border:1px solid rgba(0,0,0,.25)}

/* ---------- Arena: teams + board ---------- */
.arena{display:grid;gap:1rem;grid-template-columns:1fr 1fr;margin-bottom:1rem}
.arena .board{grid-column:1/-1;order:3}
@media(min-width:1000px){.arena{grid-template-columns:minmax(12rem,1fr) minmax(0,3.2fr) minmax(12rem,1fr)}.arena .board{grid-column:auto;order:0}}
.team{position:relative;border-radius:var(--radius);padding:.9rem 1rem;background:var(--surface);border:2.5px solid var(--line);box-shadow:var(--shadow);transition:border-color .2s, box-shadow .2s, transform .2s}
.team[data-team="0"]{--tc:var(--teamA);--tcb:var(--teamA-bg)}
.team[data-team="1"]{--tc:var(--teamB);--tcb:var(--teamB-bg)}
.team.active{border-color:var(--tc);background:linear-gradient(180deg,var(--tcb),var(--surface) 70%);box-shadow:0 0 0 5px color-mix(in srgb,var(--tc) 28%,transparent),var(--shadow);transform:translateY(-2px)}
.team .tname{font-weight:850;font-size:1.3rem;color:var(--tc);overflow-wrap:anywhere;line-height:1.1}
.upnow{display:inline-block;visibility:hidden;margin-top:.35rem;font-size:.78rem;font-weight:900;letter-spacing:.09em;background:var(--tc);color:var(--surface);border-radius:999px;padding:.12em .65em}
.team.active .upnow{visibility:visible}
.team .score{font-size:2.6rem;font-weight:900;font-variant-numeric:tabular-nums;line-height:1;margin-top:.5rem}
.team .score-label{font-size:.78rem;font-weight:800;letter-spacing:.08em;color:var(--muted);text-transform:uppercase}
.team .banked{margin-top:.45rem;font-variant-numeric:tabular-nums;font-weight:700}
.pop{position:absolute;right:1rem;top:.6rem;font-weight:900;font-size:1.6rem;pointer-events:none;animation:pop 1.3s ease-out forwards}
.pop.good{color:var(--ok)} .pop.bad{color:var(--bad)}
@keyframes pop{0%{opacity:0;transform:translateY(10px) scale(.8)}15%{opacity:1;transform:translateY(0) scale(1.1)}100%{opacity:0;transform:translateY(-40px) scale(1)}}

.board{background:linear-gradient(180deg,var(--board),var(--board-2));border-radius:var(--radius);padding:.9rem 1rem 1rem;box-shadow:inset 0 0 0 3px rgba(255,255,255,.06),var(--shadow);display:flex;flex-direction:column;justify-content:center;min-width:0}
.board .cat{color:#fff;text-align:center;font-weight:850;letter-spacing:.14em;text-transform:uppercase;font-size:.95rem;margin-bottom:.6rem}
.board .cat span{background:rgba(255,255,255,.12);border-radius:999px;padding:.2em .9em}
.words{display:flex;flex-wrap:wrap;justify-content:center;gap:.55rem 1.3rem}
.word{display:flex;gap:.22rem}
.tile{--tw:clamp(1.05rem,2.35vw,2.9rem);width:var(--tw);height:calc(var(--tw) * 1.3);display:grid;place-items:center;border-radius:.35rem;background:var(--tile);color:var(--tile-ink);font-weight:900;font-size:calc(var(--tw) * .62);box-shadow:inset 0 -3px 0 rgba(0,0,0,.25)}
.tile.hidden{background:var(--tile-hidden);color:transparent;box-shadow:inset 0 -3px 0 var(--tile-edge)}
.tile.flip{animation:flip .55s ease both}
@keyframes flip{0%{transform:rotateX(90deg);background:var(--gold)}60%{background:var(--gold);color:var(--gold-ink)}100%{transform:rotateX(0)}}
.used-letters{color:#d6ebe4;text-align:center;font-size:.9rem;margin-top:.6rem;min-height:1.4em;letter-spacing:.18em;font-weight:700}
body[data-view="question"] .tile, body[data-view="solve-q"] .tile{--tw:clamp(.9rem,1.6vw,2rem)}
body[data-view="question"] .team .score{font-size:2rem}

/* ---------- Wheel view ---------- */
.stage{min-width:0}
.wheel-view{display:grid;gap:1.2rem;align-items:center}
@media(min-width:1000px){.wheel-view{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}}
.wheel-box{position:relative;width:min(100%,62vh,640px);aspect-ratio:1;margin:0 auto}
.wheel-box svg{width:100%;height:100%;display:block;filter:drop-shadow(0 14px 28px rgba(0,0,0,.25))}
#pointer{transform-origin:0px -212px;transform-box:view-box}
#pointer.tick{animation:tick .12s ease}
@keyframes tick{50%{transform:rotate(-14deg)}}
.rim-light{fill:#fff6cf}
svg.spinning .rim-light{animation:blink .5s steps(2) infinite}
svg.spinning .rim-light:nth-of-type(odd){animation-delay:.25s}
@keyframes blink{50%{fill:#f2b705}}
.wheel-side{display:grid;gap:1rem;justify-items:center;text-align:center}
@media(min-width:1000px){.wheel-side{justify-items:start;text-align:left}}
.turn-callout{font-size:clamp(1.8rem,3.2vw,3rem);font-weight:900;line-height:1.05;letter-spacing:-.02em}
.turn-callout .tn{color:var(--tc)}
.message{font-size:1.35rem;font-weight:650;min-height:1.6em;margin:0}
.landed{display:inline-flex;align-items:center;gap:.5rem;font-size:1.25rem;font-weight:850;border-radius:14px;padding:.35em .9em;border:2px solid rgba(0,0,0,.15)}
.side-actions{display:flex;flex-wrap:wrap;gap:.8rem}
.legend{display:flex;flex-wrap:wrap;gap:.45rem .9rem;font-size:.88rem;color:var(--muted)}

/* ---------- Question / panels ---------- */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:1.3rem 1.5rem}
.qhead{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;justify-content:space-between;margin-bottom:1rem}
.who{display:inline-flex;align-items:center;gap:.5rem;font-weight:900;font-size:1.3rem;border-radius:999px;padding:.25em .9em;background:var(--tcb);color:var(--tc);border:2px solid var(--tc)}
.who[data-team="0"]{--tc:var(--teamA);--tcb:var(--teamA-bg)} .who[data-team="1"]{--tc:var(--teamB);--tcb:var(--teamB-bg)}
.prize{font-weight:800;font-size:1.1rem}
.stars{letter-spacing:.12em;color:var(--gold)}
.stem{font-size:clamp(1.2rem,1.55vw,2.05rem);line-height:1.4;font-weight:550;white-space:pre-line;margin-bottom:1rem;max-width:72ch}
.options{display:grid;gap:.8rem;margin:0 0 1rem}
@media(min-width:1000px){.options{grid-template-columns:1fr 1fr}}
.opt{display:flex;gap:.85rem;align-items:center;text-align:left;width:100%;padding:.85em 1em;min-height:4.2rem;font-size:clamp(1.05rem,1.3vw,1.65rem);font-weight:650;border-width:2.5px;border-radius:16px;background:var(--surface-2);position:relative}
.keycap{flex:0 0 auto;width:2.1em;height:2.1em;border-radius:10px;display:grid;place-items:center;background:var(--surface);border:2px solid var(--line);font-weight:900;font-size:.85em}
.opt.selected{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 14%,var(--surface));box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 25%,transparent)}
.opt.selected .keycap{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.opt:disabled,.m-card:disabled{opacity:.82;cursor:default}
.opt.eliminated{opacity:.55}
.opt.eliminated .opt-text{text-decoration:line-through}
.opt.is-answer{border-color:var(--ok);background:var(--ok-bg);opacity:1}
.opt.is-answer .keycap{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.is-wrong{border-color:var(--bad);background:var(--bad-bg);opacity:1}
.opt.is-wrong .keycap{background:var(--bad);border-color:var(--bad);color:#fff}
.mark{margin-left:auto;font-weight:900;white-space:nowrap;font-size:.8em;padding-left:.5rem}
.mark.ok{color:var(--ok)} .mark.bad{color:var(--bad)}

/* Match: tap-to-pair cards, everything visible at once */
.match{display:grid;gap:1rem;margin-bottom:1rem}
@media(min-width:1000px){.match{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}}
.match-col{display:grid;gap:.6rem;align-content:start}
.col-head{font-weight:850;font-size:.85rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.m-card{display:flex;gap:.75rem;align-items:center;text-align:left;width:100%;padding:.7em .9em;min-height:3.6rem;font-size:clamp(1rem,1.18vw,1.45rem);font-weight:650;border-width:2.5px;border-radius:14px;background:var(--surface-2)}
.m-card .m-text{flex:1}
.letter-chip{flex:0 0 auto;width:2em;height:2em;border-radius:50%;display:grid;place-items:center;font-weight:900;color:#fff;background:var(--pc,#64748b);font-size:.9em}
.m-slot{flex:0 0 auto;min-width:2.4em;text-align:center;font-weight:900;border-radius:10px;padding:.2em .45em;border:2px dashed var(--line);color:var(--muted);font-size:.9em}
.m-card.active{border-color:var(--pc);box-shadow:0 0 0 4px color-mix(in srgb,var(--pc) 30%,transparent)}
.m-card.filled .m-slot{border-style:solid;border-color:var(--pc);color:var(--ink)}
.m-right.taken{border-color:var(--pc)}
.m-right .m-slot .letter-chip{width:1.8em;height:1.8em}
.m-card.is-answer{border-color:var(--ok);background:var(--ok-bg)}
.m-card.is-wrong{border-color:var(--bad);background:var(--bad-bg)}

/* Order */
.order-list{list-style:none;padding:0;margin:0 0 1rem;display:grid;gap:.6rem}
.order-list li{display:flex;gap:.8rem;align-items:center;border:2.5px solid var(--line);border-radius:14px;padding:.55rem .7rem;background:var(--surface-2);font-size:clamp(1.02rem,1.22vw,1.5rem);font-weight:650;transition:transform .2s}
.order-list .pos{flex:0 0 auto;width:2em;height:2em;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);font-weight:900}
.order-list .txt{flex:1}
.order-list button{min-width:3rem;min-height:3rem;font-size:1.1rem;padding:0}
.order-list li.moved{animation:nudge .35s ease}
@keyframes nudge{40%{transform:scale(1.02);border-color:var(--accent)}}
.order-list li.is-answer{border-color:var(--ok);background:var(--ok-bg)}
.order-list li.is-wrong{border-color:var(--bad);background:var(--bad-bg)}

.actions{display:flex;gap:.8rem;flex-wrap:wrap;align-items:center;margin-top:.5rem}
.timer-ring{position:relative;width:3.2rem;height:3.2rem}
.timer-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.timer-ring .trk{stroke:var(--line)} .timer-ring .bar{stroke:var(--accent);transition:stroke-dashoffset 1s linear}
.timer-ring.low .bar{stroke:var(--bad)}
.timer-ring span{position:absolute;inset:0;display:grid;place-items:center;font-weight:900;font-variant-numeric:tabular-nums}

.steal-banner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;border-radius:16px;padding:1rem 1.2rem;border:3px solid var(--bad);background:var(--bad-bg);margin-top:.4rem}
.steal-banner .big{font-size:1.6rem;font-weight:900;color:var(--bad)}
.verdict-banner{display:flex;align-items:center;gap:.8rem;font-size:clamp(1.5rem,2.4vw,2.6rem);font-weight:900;border-radius:16px;padding:.5em .8em;margin:.2rem 0 1rem}
.verdict-banner.ok{background:var(--ok-bg);color:var(--ok);border:3px solid var(--ok)}
.verdict-banner.bad{background:var(--bad-bg);color:var(--bad);border:3px solid var(--bad)}
.verdict-banner .vi{font-size:1.2em}
.fb-grid{display:grid;gap:1rem}
@media(min-width:1000px){.fb-grid{grid-template-columns:1.1fr 1fr}}
.fb-block h3{font-size:.85rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-bottom:.35rem}
.fb-block p,.fb-block li{font-size:clamp(1rem,1.12vw,1.4rem)}
.fb-block ul,.fb-block ol{margin:0;padding-left:1.2em}
.fb-block li{margin-bottom:.35em}
.pearl{border-radius:14px;padding:.8rem 1rem;background:color-mix(in srgb,var(--gold) 18%,var(--surface));border:2px solid var(--gold);font-size:clamp(1.05rem,1.25vw,1.55rem);font-weight:700;margin:1rem 0 .6rem}
.pearl .pl{font-weight:900;letter-spacing:.08em;font-size:.75em;text-transform:uppercase;display:block;margin-bottom:.15rem}
.badge{display:inline-block;font-size:.85rem;font-weight:700;border-radius:8px;padding:.2em .7em;border:1.5px solid var(--line);background:var(--surface-2)}
.badge.unverified{border-style:dashed}

/* Letters */
.letters{display:grid;grid-template-columns:repeat(7,1fr);gap:.5rem;margin:1rem 0}
@media(min-width:700px){.letters{grid-template-columns:repeat(13,1fr)}}
.letters button{min-height:3.6rem;font-size:1.6rem;font-weight:900;padding:0;border-width:2.5px;border-radius:12px;position:relative}
.letters button.vowel{border-style:dashed;background:var(--surface-2)}
.letters button.vowel::after{content:"−100";position:absolute;bottom:.15rem;left:0;right:0;font-size:.55rem;font-weight:800;color:var(--muted)}
.letter-result{font-size:clamp(2rem,4vw,3.6rem);font-weight:900;margin:.3rem 0 .6rem}
.solve-input{font-size:clamp(1.4rem,2.2vw,2.4rem) !important;text-transform:uppercase;letter-spacing:.08em;font-weight:800;min-height:4rem !important}

.game-foot{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.2rem;color:var(--muted);font-weight:650}

/* End */
.winner-card{text-align:center;padding:2rem 1.5rem}
.winner{font-size:clamp(2.2rem,4.5vw,4rem);font-weight:900;letter-spacing:-.02em;line-height:1.05}
.finals{display:flex;justify-content:center;gap:1.2rem;flex-wrap:wrap;margin:1.2rem 0}
.final{min-width:12rem;border-radius:18px;padding:1rem 1.4rem;border:3px solid var(--tc);background:var(--tcb)}
.final[data-team="0"]{--tc:var(--teamA);--tcb:var(--teamA-bg)} .final[data-team="1"]{--tc:var(--teamB);--tcb:var(--teamB-bg)}
.final .tname{font-weight:900;color:var(--tc);font-size:1.2rem}
.final .pts{font-size:2.8rem;font-weight:900;font-variant-numeric:tabular-nums}
.end-grid{display:grid;gap:1rem;margin-top:1rem}
@media(min-width:1000px){.end-grid{grid-template-columns:1fr 1fr}}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;font-size:1rem}
th,td{border-bottom:1px solid var(--line);padding:.5rem .6rem;text-align:left}
thead th{font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
tbody tr:last-child th,tbody tr:last-child td{border-bottom:0;font-weight:900}
.table-wrap{overflow-x:auto}
details{border:1px solid var(--line);border-radius:14px;padding:.7rem 1rem;margin-bottom:.6rem;background:var(--surface-2)}
summary{cursor:pointer;font-weight:750;font-size:1.05rem}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:40}

/* Pearls */
.flip-wrap{perspective:1600px}
.flip-card{width:100%;min-height:min(56vh,30rem);border:0;padding:0;background:transparent;display:block;position:relative;transform-style:preserve-3d;transition:transform .6s ease;border-radius:24px}
.flip-card.flipped{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:24px;padding:2rem 2.2rem;display:flex;flex-direction:column;justify-content:center;text-align:left;box-shadow:var(--shadow);border:1px solid var(--line)}
.face.front{background:var(--surface)}
.face.back{background:linear-gradient(160deg,color-mix(in srgb,var(--gold) 22%,var(--surface)),var(--surface));transform:rotateY(180deg);border:3px solid var(--gold)}
.face .side-label{font-size:.85rem;font-weight:900;letter-spacing:.12em;color:var(--muted);margin-bottom:.8rem;text-transform:uppercase}
.face .front-text{font-size:clamp(1.1rem,1.5vw,1.9rem);white-space:pre-line;font-weight:550}
.face .back-text{font-size:clamp(1.6rem,2.6vw,3rem);font-weight:850;line-height:1.2}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
}
