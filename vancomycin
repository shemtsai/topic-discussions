<body>

<header class="top">
  <div class="top-inner">
    <h1 class="title">Vancomycin Dosing Trainer <span>&nbsp;PGY1 · adult general medicine</span></h1>
    <div class="top-stats">
      <div class="stat">Case<b id="statCase">1/14</b></div>
      <div class="stat">Session<b id="statScore">—</b></div>
    </div>
  </div>
  <div class="trackbar" id="trackbar"></div>
</header>

<div class="wrap">
  <section class="card" id="primerCard">
    <h2>Reference panel — open any section at any time</h2>
    <div id="primerContent"></div>
  </section>

  <main id="stage"></main>

  <p class="foot">
    Built for training only. Dosing logic follows the 2020 ASHP/IDSA/PIDS/SIDP consensus guideline;
    assumptions where the guideline permits institutional variation are listed in the comment block
    at the top of this file's source. Verify against your institution's protocol before clinical use.
  </p>
</div>

<script>
/* ==================================================================================
   SECTION 1 — ASSUMPTIONS, CONSTANTS, AND PHARMACOKINETIC HELPERS
   Every number a pharmacist would want to audit lives here or in the CASES array.
   ================================================================================== */

const DOSING_ASSUMPTIONS = {
  aucTargetLow: 400,          // 2020 consensus, firm
  aucTargetHigh: 600,         // 2020 consensus, firm
  loadingMgKgLow: 20,         // 2020 consensus range is 20-35 mg/kg actual body weight
  loadingMgKgTarget: 25,      // institutional default chosen here
  loadingMgKgHigh: 30,        // grading ceiling; guideline permits up to 35 in critical illness
  loadingCapMg: 3000,         // ASSUMPTION - institutional. 2000-3000 mg is the usual range.
  maxTotalDailyMg: 4500,      // ASSUMPTION - safety flag threshold, not a guideline hard stop
  maxSingleMaintenanceMg: 2000, // ASSUMPTION - practicality, not a guideline number
  aucNephroThreshold: 600     // 2020 consensus: AUC >600 linked to higher AKI risk
};

/* Ideal body weight (Devine). Height in inches. */
function ibw(heightIn, sex){
  const base = sex === 'F' ? 45.5 : 50;
  return +(base + 2.3 * Math.max(0, heightIn - 60)).toFixed(1);
}
/* Adjusted body weight, 0.4 correction factor. */
function adjbw(tbw, heightIn, sex){
  const i = ibw(heightIn, sex);
  return +(i + 0.4 * (tbw - i)).toFixed(1);
}
/* Weight to use INSIDE Cockcroft-Gault. Standard clinical convention, not part of the
   original C-G paper: underweight -> TBW, normal -> IBW, obese (>=125% IBW) -> AdjBW. */
function cgWeight(tbw, heightIn, sex){
  const i = ibw(heightIn, sex);
  if (tbw < i) return { w: tbw, which: 'total body weight' };
  if (tbw >= 1.25 * i) return { w: adjbw(tbw, heightIn, sex), which: 'adjusted body weight' };
  return { w: i, which: 'ideal body weight' };
}
/* Cockcroft-Gault. */
function cockcroftGault(age, sex, weightKg, scr){
  const v = ((140 - age) * weightKg) / (72 * scr) * (sex === 'F' ? 0.85 : 1);
  return +v.toFixed(1);
}
/* Vancomycin clearance, Matzke 1984. Returns L/h. */
function vancClearance(crcl){
  const mlmin = 0.689 * crcl + 3.66;
  return +(mlmin * 0.06).toFixed(3);
}
/* Population point-estimate of AUC24. NOT a substitute for measured levels. */
function estimateAUC(totalDailyMg, crcl){
  return Math.round(totalDailyMg / vancClearance(crcl));
}
/* Total daily dose from a dose + interval selection. */
function tddFrom(dose, interval){
  if (interval === 'ci') return dose;                 // dose field = mg per 24 h for CI
  if (['posthd','bylevel'].includes(interval)) return null;
  return dose * (24 / Number(interval));
}
const round250 = n => Math.round(n / 250) * 250;

/* ==================================================================================
   SECTION 2 — CONCEPT PRIMER
   This is the ONLY knowledge source the learner needs. Every case is solvable using
   nothing but the content below, which is a hard requirement: no case may depend on
   a rule that is not taught here.
   ================================================================================== */

const PRIMER = [
  { id:'approach', title:'How to approach any vancomycin case (start here)', open:true, html:`
    <p>Six steps, in this order, every time. The cases in this trainer are just this sequence
    applied to harder patients.</p>
    <ol>
      <li><b>Describe the patient in numbers.</b> Age, sex, total body weight, height. Calculate
      ideal body weight; if the patient is at or above 125% of ideal body weight, also calculate
      adjusted body weight.</li>
      <li><b>Ask whether renal function is at steady state</b> before you calculate anything.
      A serum creatinine that is climbing or falling day to day cannot be used in Cockcroft-Gault.
      This question comes before the math, not after it.</li>
      <li><b>Estimate creatinine clearance</b> using Cockcroft-Gault with the correct weight.</li>
      <li><b>Decide whether a loading dose is indicated.</b> Serious infection, deep-seated
      infection, or critical illness &rarr; yes. The loading dose depends on volume of
      distribution, so it uses <b>actual body weight</b> and is <b>not reduced for renal
      impairment</b>.</li>
      <li><b>Pick a maintenance total daily dose that lands the AUC<sub>24</sub> in 400&ndash;600</b>,
      then split it into an interval that suits the patient's clearance.</li>
      <li><b>Write the monitoring plan.</b> Which levels, drawn when, and what you will do with
      them. A regimen without a monitoring plan is an incomplete answer.</li>
    </ol>
    <div class="callout">The most common PGY1 error is not arithmetic. It is skipping step 2 and
    step 6.</div>
    <div class="callout warn"><b>In this trainer, steps 1 to 3 are done for you.</b> Each case shows
    the ideal body weight, the adjusted body weight where it applies, and the Cockcroft-Gault result
    with the weight it used &mdash; so the exercise is the regimen itself: load, dose, interval,
    monitoring. Step 2 still belongs to you. When the estimate on the panel should not be trusted,
    the panel says so, and deciding what to do about that is part of the case. Read this section
    anyway; on the wards nobody calculates it for you.</div>`},

  { id:'crcl', title:'Cockcroft-Gault and choosing the right weight', html:`
    <p>The trainer computes this for each case and shows you which weight it used. The equation is
    here because you will need to run it yourself, and because knowing which inputs it is sensitive
    to is what tells you when to distrust the answer.</p>
    <div class="formula">CrCl (mL/min) = [(140 &minus; age) &times; weight<sub>kg</sub>] &divide; (72 &times; SCr) &nbsp;&times; 0.85 if female</div>
    <h4>Which weight goes in the equation</h4>
    <table class="ref">
      <tr><th>Situation</th><th>Weight to use</th></tr>
      <tr><td>Total body weight below ideal body weight</td><td class="num">Total body weight</td></tr>
      <tr><td>Total body weight between 100% and 125% of ideal</td><td class="num">Ideal body weight</td></tr>
      <tr><td>Total body weight at or above 125% of ideal</td><td class="num">Adjusted body weight</td></tr>
    </table>
    <div class="formula">IBW (male)   = 50   + 2.3 &times; (inches over 60)
IBW (female) = 45.5 + 2.3 &times; (inches over 60)
AdjBW        = IBW + 0.4 &times; (TBW &minus; IBW)</div>
    <p>This weight-selection convention is standard practice rather than part of the original
    Cockcroft-Gault publication. Using total body weight in an obese patient badly overestimates
    clearance and is a classic route to a supratherapeutic regimen.</p>
    <h4>When Cockcroft-Gault is not trustworthy</h4>
    <ul>
      <li><b>Non-steady-state creatinine.</b> The equation assumes a stable SCr. If creatinine is
      rising, true clearance is <i>lower</i> than the equation says; if falling, it is higher.</li>
      <li><b>Low muscle mass.</b> An elderly, sarcopenic, or malnourished patient can have a
      "normal" creatinine with genuinely poor clearance. Some institutions round SCr up
      (commonly to 0.8 or 1.0 mg/dL) in patients over 65; this is a local convention with no
      guideline endorsement, and it can equally cause under-dosing. Know which convention your
      institution uses, and let early levels settle the question rather than the equation.</li>
      <li><b>Anuria or dialysis.</b> Creatinine clearance is not a meaningful concept; dose by
      the renal replacement modality instead.</li>
    </ul>`},

  { id:'load', title:'Loading dose: why it exists and when to give one', html:`
    <p>A loading dose is a <b>volume of distribution</b> problem, not a clearance problem.
    Vancomycin's V<sub>d</sub> is roughly 0.7 L/kg. Clearance determines how fast the drug leaves;
    volume of distribution determines how much drug it takes to fill the space in the first place.</p>
    <div class="callout"><b>The rule that catches almost everyone:</b> renal impairment does not
    shrink the volume of distribution. A patient in acute kidney injury still gets the full
    loading dose. What changes is the maintenance dose and interval afterward.</div>
    <table class="ref">
      <tr><th>Parameter</th><th>Value</th></tr>
      <tr><td>Loading dose</td><td class="num">20&ndash;35 mg/kg <b>actual body weight</b> (25 mg/kg is a reasonable default)</td></tr>
      <tr><td>Cap used in this trainer</td><td class="num">3,000 mg</td></tr>
      <tr><td>Infuse over</td><td class="num">&ge;60 min, and no faster than 1,000 mg/h</td></tr>
    </table>
    <p>The 3,000 mg cap is an <b>institutional assumption</b>, not a guideline number; caps of
    2,000&ndash;3,000 mg are both in common use. Loading doses are indicated for seriously ill
    patients and deep-seated infection. For a non-severe skin infection in a stable patient,
    skipping the load is defensible.</p>`},

  { id:'maint', title:'Maintenance dosing by renal function', html:`
    <p>These are <b>starting points</b>, not answers. The regimen is confirmed or corrected by
    levels, never by the table alone.</p>
    <table class="ref">
      <tr><th>CrCl (mL/min)</th><th>Typical starting regimen</th><th>Note</th></tr>
      <tr><td class="num">&gt;130</td><td>15&ndash;20 mg/kg q8h</td><td>Augmented renal clearance; shorten the interval rather than inflating the dose</td></tr>
      <tr><td class="num">90&ndash;130</td><td>15&ndash;20 mg/kg q12h</td><td>The default adult regimen</td></tr>
      <tr><td class="num">50&ndash;89</td><td>10&ndash;15 mg/kg q12h, or 15&ndash;20 mg/kg q24h</td><td>Either interval is defensible; pick by total daily dose</td></tr>
      <tr><td class="num">30&ndash;49</td><td>15 mg/kg q24h</td><td></td></tr>
      <tr><td class="num">15&ndash;29</td><td>15 mg/kg q24&ndash;48h</td><td>Draw a level early</td></tr>
      <tr><td class="num">&lt;15, not on RRT</td><td>Load, then redose by level</td><td>Scheduled intervals are guesses here</td></tr>
      <tr><td>Intermittent HD</td><td>Load, then 7.5&ndash;10 mg/kg after each session</td><td>Pre-dialysis levels guide it</td></tr>
      <tr><td>CRRT</td><td>Load, then 7.5&ndash;10 mg/kg q12h or 15&ndash;20 mg/kg q24h</td><td>Effluent rate drives clearance</td></tr>
    </table>
    <h4>Working out the total daily dose from the target</h4>
    <div class="formula">AUC<sub>24</sub> = total daily dose (mg) &divide; vancomycin clearance (L/h)
so   total daily dose = target AUC<sub>24</sub> &times; clearance

Population estimate of clearance:
CL<sub>vanc</sub> (mL/min) = 0.689 &times; CrCl (mL/min) + 3.66      [Matzke 1984]
CL<sub>vanc</sub> (L/h)    = CL<sub>vanc</sub> (mL/min) &times; 0.06</div>
    <p>Worked example. A patient with CrCl 90 mL/min: CL<sub>vanc</sub> = 0.689(90) + 3.66 =
    65.7 mL/min = 3.94 L/h. Targeting AUC<sub>24</sub> 500 gives 500 &times; 3.94 &asymp; 1,970 mg/day,
    so 1,000 mg q12h. Then <b>check a level</b> &mdash; this equation is a population average,
    and your patient is not the average.</p>
    <div class="callout warn">Safety ceilings used here: total daily dose above 4,500 mg and single
    maintenance doses above 2,000 mg both warrant a hard look. Daily doses at or above 4 g are an
    independent nephrotoxicity risk factor.</div>`},

  { id:'monitor', title:'AUC-guided monitoring, and why troughs fell out of favour', html:`
    <h4>The target</h4>
    <p>For serious MRSA infection, target <b>AUC<sub>24</sub>/MIC of 400&ndash;600</b>, assuming an
    MIC of 1 mg/L by broth microdilution. Below 400 risks treatment failure and resistance
    selection; above 600 the nephrotoxicity risk climbs without added benefit.</p>
    <h4>How to obtain it</h4>
    <ul>
      <li><b>Bayesian software</b> with one level (often a trough) &mdash; can be drawn as early as
      after the first or second dose, before steady state. This is the preferred method where the
      software is available.</li>
      <li><b>Two levels with first-order equations</b> &mdash; a post-distribution peak roughly
      1&ndash;2 h after the end of the infusion, plus a trough within 30 min of the next dose,
      drawn at steady state (usually around the fourth dose).</li>
    </ul>
    <h4>Why trough-only monitoring is no longer recommended</h4>
    <p>The 2020 consensus guideline explicitly moved away from trough-only monitoring targeting
    15&ndash;20 mg/L for serious MRSA infection. A trough is a single point on a curve, and the
    trough that corresponds to an AUC of 400&ndash;600 varies widely between patients. Aiming
    every patient at a trough of 15&ndash;20 pushes a substantial fraction well above an AUC of
    600 &mdash; that is, it produces nephrotoxicity risk with no additional efficacy. The older
    targets (10&ndash;15 mg/L for less severe infection, 15&ndash;20 mg/L for serious infection)
    appear here only so you recognise them on an older order set.</p>
    <h4>Re-check when</h4>
    <ul>
      <li>Renal function changes meaningfully in either direction</li>
      <li>You change the dose or interval</li>
      <li>Roughly weekly on stable, prolonged therapy, alongside serum creatinine</li>
      <li>Clinical failure, or a new nephrotoxin is started</li>
    </ul>`},

  { id:'nephro', title:'Nephrotoxicity: what actually drives risk', html:`
    <ul>
      <li><b>AUC<sub>24</sub> above 600</b> &mdash; the exposure threshold identified in the 2020 consensus</li>
      <li><b>Concurrent piperacillin-tazobactam</b> &mdash; a repeatedly identified AKI signal with
      vancomycin. Cefepime or meropenem are commonly substituted when the gram-negative coverage
      still needs to be broad. This is usually the most modifiable risk factor on the list.</li>
      <li>Total daily dose at or above 4 g</li>
      <li>Duration beyond about 7 days</li>
      <li>ICU admission, hemodynamic instability, vasopressors</li>
      <li>Other nephrotoxins: aminoglycosides, amphotericin B, IV contrast, NSAIDs, loop diuretics</li>
      <li>Obesity, and pre-existing renal impairment</li>
    </ul>
    <div class="callout">When a patient carries several of these, the answer is rarely "give less
    vancomycin and hope." It is: hit the target deliberately, monitor early, and remove the
    modifiable risk &mdash; most often by changing the companion antibiotic or by asking whether a
    different MRSA agent fits the infection better.</div>`},

  { id:'special', title:'Special situations at a glance', html:`
    <h4>Obesity</h4>
    <p>Two separate decisions that are easy to conflate. <b>The creatinine clearance estimate</b>
    uses adjusted body weight. <b>The vancomycin dose</b> uses actual body weight &mdash; but at a
    lower mg/kg than you would use in a lean patient, because vancomycin clearance and volume of
    distribution do not scale linearly with fat mass. In practice, AUC-guided regimens in class II
    to III obesity often land near 10&ndash;12 mg/kg per dose rather than 15&ndash;20, and the
    4,500 mg/day ceiling is reached quickly. Load on actual body weight, capped.</p>
    <h4>Augmented renal clearance</h4>
    <p>Typically young, no prior renal disease, trauma, burns, febrile neutropenia, or early
    sepsis; CrCl above roughly 130 mL/min. Shorten the interval to q8h rather than pushing single
    doses upward, consider continuous infusion, and draw levels early. Augmented clearance often
    recedes as the patient recovers, so the regimen that was right on day two can be too much on
    day six.</p>
    <h4>Intermittent hemodialysis</h4>
    <p>Vancomycin is removed appreciably by modern high-flux dialyzers. Load 20&ndash;25 mg/kg
    actual body weight, then give a supplemental dose after each session (commonly
    7.5&ndash;10 mg/kg, or 500&ndash;1,000 mg), guided by a pre-dialysis level. Do not write a
    q24h or q48h schedule that ignores the dialysis calendar.</p>
    <h4>CRRT</h4>
    <p>Continuous therapy provides continuous clearance, roughly tracking the effluent rate. These
    patients are <b>not</b> anuric from a dosing standpoint. Load, then 7.5&ndash;10 mg/kg q12h or
    15&ndash;20 mg/kg q24h, with a level at around 24 h. Under-dosing here is at least as common
    as over-dosing.</p>`}
];

